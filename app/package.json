{
  "name": "trama",
  "productName": "Trama",
  "version": "0.1.0",
  "private": true,
  "description": "Trama: coordina decisioni, lavoro e verifiche su un repository locale.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:names": "node scripts/check-file-names.mjs",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "ui-check": "npm run build && node scripts/ui-check.mjs ui-check"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.trama.app",
    "productName": "Trama",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "resources/DemoProject",
        "to": "DemoProject"
      },
      {
        "from": "resources/AIHero",
        "to": "AIHero"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": false
    },
    "linux": {
      "icon": "resources/icons/png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@earendil-works/**"
    ]
  },
  "author": "Emanuele Denaro",
  "repository": {
    "type": "git",
    "url": "https://github.com/emanueledenaro/trama.git"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.259",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@opencode-ai/sdk": "1.18.31",
    "yaml": "2.9.0"
  }
}
