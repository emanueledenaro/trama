#!/bin/sh
# Optional local guard for Conventional Commits 1.0.0. No dependencies beyond Node.
# Install once with:
#   git config core.hooksPath scripts/conventional-commits/hooks
# Remove with:
#   git config --unset core.hooksPath
set -e
repo_root=$(git rev-parse --show-toplevel)
node "$repo_root/scripts/conventional-commits/cli.mjs" commit-msg-file "$1"
